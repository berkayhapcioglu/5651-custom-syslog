[Unit]
Description=5651 syslog collector (sealed, time stamped firewall logs)
Documentation=file:///usr/share/doc/syslog5651/KURULUM.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syslog5651
Group=syslog5651
ExecStart=/usr/bin/syslog5651 run -config /etc/syslog5651/config.yaml
Restart=always
RestartSec=3
TimeoutStopSec=120
LimitNOFILE=65536
UMask=0077

# Only privilege kept: binding ports below 1024 (514 syslog).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem: everything read-only except the data directory.
ProtectSystem=strict
ReadWritePaths=/var/lib/syslog5651
ReadOnlyPaths=/etc/syslog5651
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel and process isolation.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @raw-io @reboot @swap

[Install]
WantedBy=multi-user.target
